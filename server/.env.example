# ==============================================================================
# DIGITAL SAFETY ESCAPE ROOM - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Use this template when setting environment variables on Render, Railway, or local.
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=production

# MongoDB URI (MongoDB Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/digital_safety_escape_room?retryWrites=true&w=majority&appName=DigitalSafetyEscapeRoom

# JWT Authentication Secret
JWT_SECRET=cyber_escape_room_secret_key_2026

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Deployed URL on Vercel (comma-separated if multiple)
CLIENT_URL=https://digital-safety-escape-room.vercel.app,http://localhost:5173
