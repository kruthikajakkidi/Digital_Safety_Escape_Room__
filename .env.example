# ==============================================================================
# DIGITAL SAFETY ESCAPE ROOM - MASTER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Backend Port
PORT=5000
NODE_ENV=production

# 1. MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/digital_safety_escape_room?retryWrites=true&w=majority&appName=DigitalSafetyEscapeRoom

# 2. JWT Secret
JWT_SECRET=your_long_random_jwt_secret_key_here

# 3. Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 4. Frontend Vercel URL (Allowed by Backend CORS)
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# 5. Frontend Environment Variables (for Vercel settings)
VITE_API_URL=https://your-backend.onrender.com/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
